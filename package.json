{
  "name": "haru-word",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:toss": "vite --mode toss",
    "build": "npm run check:puzzles && tsc -b && vite build",
    "build:toss": "npm run check:puzzles && tsc -b && vite build --mode toss && ait build",
    "deploy:toss": "ait deploy",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "check:puzzles": "node --experimental-strip-types scripts/check-puzzles.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "^3.11.0",
    "@apps-in-toss/web-framework": "^3.11.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
